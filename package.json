{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prebuild": "node ./scripts/apply-supabase-runtime.js",
    "audit": "npm audit --audit-level=high",
    "security-check": "node scripts/check-env.js",
    "check-deps": "npx npm-check-updates",
    "vuln-scan": "npx snyk test",
    "backup": "node scripts/backup-supabase.js",
    "backup:files": "node scripts/backup-files.js",
    "backup:all": "npm run backup && npm run backup:files",
    "backup:cron": "node scripts/backup-supabase.js >> logs/backup.log 2>&1",
    "restore": "node scripts/restore-backup.js",
    "backup:list": "node scripts/list-backups.js",
    "backup:clean": "node scripts/cleanup-backups.js",
    "generate-keys": "node scripts/generate-keys.js",
    "check-env": "node scripts/env-validator.js",
    "setup": "npm install && npm run generate-keys",
    "reset": "npm run backup:all && rm -rf .next node_modules && npm run setup",
    "db:seed": "node scripts/seed-database.js",
    "db:migrate": "npx supabase db push",
    "db:reset": "node scripts/reset-database.js",
    "db:status": "npx supabase status",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "ANALYZE=true npm run build",
    "build:prod": "NODE_ENV=production npm run build",
    "deploy:dev": "netlify deploy --dir=.next",
    "deploy:prod": "netlify deploy --dir=.next --prod"
  },
  "engines": {
    "node": ">=18 <21",
    "npm": ">=9"
  },
  "dependencies": {
    "@fal-ai/client": "^1.7.2",
    "@fal-ai/serverless-client": "^0.15.0",
    "@hookform/resolvers": "^3.9.0",
    "@netlify/plugin-nextjs": "^5.15.2",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.87.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.15",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "eslint": "8.49.0",
    "eslint-config-next": "14.0.4",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.446.0",
    "next": "^14.2.35",
    "next-themes": "^0.3.0",
    "postcss": "^8.5.6",
    "react": "18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.3.3",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "archiver": "^6.0.2",
    "concurrently": "^8.2.2",
    "dotenv": "^16.6.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fs-extra": "^11.3.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "npm-check-updates": "^16.14.12",
    "prettier": "^3.1.0",
    "snyk": "^1.1268.0"
  },
  "packageManager": "npm@10.2.4",
  "resolutions": {
    "next": "14.2.35"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
